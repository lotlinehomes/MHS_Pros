# Copy to .env.local for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.
# Nothing here is required for the site to build or run.

# Optional override for the public site URL (defaults to seo.siteUrl in content/site.ts).
NEXT_PUBLIC_SITE_URL=https://mobilehomesetuppros.com

# --- LotStack: quote requests are sent to LotStack's set-up quote API (see README) ---
# Server key issued by LotStack. Requests are only sent when this is set; otherwise they're logged.
LOTSTACK_API_KEY=
# Optional: defaults to https://lotstack.ai/api/setup/quote-requests
LOTSTACK_API_URL=
