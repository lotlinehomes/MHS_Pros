# Copy to .env.local for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.
# Nothing here is required for the site to build or run.

# Optional override for the public site URL (defaults to seo.siteUrl in content/site.ts).
NEXT_PUBLIC_SITE_URL=https://mobilehomesetuppros.com

# --- Smartsheet: quote requests are written to the "MHS Pros" sheet (see README) ---
# Smartsheet → Account → Personal Settings → API Access → Generate new access token.
SMARTSHEET_ACCESS_TOKEN=
# Optional: pin a specific sheet instead of looking it up by name.
SMARTSHEET_SHEET_ID=
# Optional: defaults to "MHS Pros".
SMARTSHEET_SHEET_NAME=
# Optional: EU accounts use https://api.smartsheet.eu/2.0
SMARTSHEET_API_BASE=

# --- LotStack (not wired up yet — see TODO(lotstack) in app/api/quote/route.ts) ---
LOTSTACK_API_URL=
LOTSTACK_API_KEY=
